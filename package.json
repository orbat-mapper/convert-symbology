  "devDependencies": {
    "@vitest/ui": "^4.1.8",
    "d3-dsv": "^3.0.1",
    "prettier": "^3.6.2",
    "tsdown": "^0.22.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
