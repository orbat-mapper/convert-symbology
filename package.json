{
  "name": "@orbat-mapper/convert-symbology",
  "version": "1.0.2",
  "description": "Convert between letter based and number based symbol identification codes (MILSTD 2525/APP6)",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/convert-symbology.umd.cjs",
  "module": "./dist/convert-symbology.js",
  "exports": {
    ".": {
      "import": "./dist/convert-symbology.js",
      "require": "./dist/convert-symbology.cjs"
    }
  },
  "types": "./dist/convert-symbology.d.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "lint-fix": "prettier --write .",
    "prepare": "tsc && vite build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbat-mapper/convert-symbology.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/orbat-mapper/convert-symbology/issues"
  },
  "homepage": "https://github.com/orbat-mapper/convert-symbology#readme",
  "devDependencies": {
    "@vitest/ui": "^2.0.5",
    "d3-dsv": "^3.0.1",
    "prettier": "^3.6.2",
    "typescript": "5.4",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^2.0.5"
  }
}
